<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.asteria</groupId>
        <artifactId>asteria</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>asteria-bootstrap</artifactId>
    <packaging>jar</packaging>

    <name>asteria-bootstrap</name>
    <description>Asteria Spring Boot startup module.</description>

    <dependencies>
        <dependency>
            <groupId>io.asteria</groupId>
            <artifactId>asteria-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.asteria</groupId>
            <artifactId>asteria-settlement</artifactId>
        </dependency>
        <dependency>
            <groupId>io.asteria</groupId>
            <artifactId>asteria-currency</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.asteria</groupId>
            <artifactId>asteria-account</artifactId>
        </dependency>
        <dependency>
            <groupId>io.asteria</groupId>
            <artifactId>asteria-ledger</artifactId>
        </dependency>
        <dependency>
            <groupId>io.asteria</groupId>
            <artifactId>asteria-payment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.asteria</groupId>
            <artifactId>asteria-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
