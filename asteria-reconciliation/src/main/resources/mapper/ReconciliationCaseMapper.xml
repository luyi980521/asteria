<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.asteria.reconciliation.infrastructure.persistence.mapper.ReconciliationCaseMapper">
    <!-- 显式映射列名，JSON 文本以 String 原样存取，金额与币种分别保存。 -->
    <resultMap id="BaseResultMap" type="io.asteria.reconciliation.infrastructure.persistence.dataobject.ReconciliationCaseDO">
        <id property="id" column="id"/>
        <result property="ruleCode" column="rule_code"/>
        <result property="businessKey" column="business_key"/>
        <result property="differenceType" column="difference_type"/>
        <result property="runId" column="run_id"/>
        <result property="matchResultId" column="match_result_id"/>
        <result property="status" column="status"/>
        <result property="assignee" column="assignee"/>
        <result property="details" column="details"/>
        <result property="resolution" column="resolution"/>
        <result property="closedAt" column="closed_at"/>
        <result property="version" column="version"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, rule_code, business_key, difference_type, run_id, match_result_id, status, assignee, details, resolution, closed_at, version, created_at, updated_at
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM reconciliation_case WHERE id = #{id}
    </select>

    <!-- 读取同类活动工单，最终并发去重仍由部分唯一索引保证。 -->
    <select id="findActive" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM reconciliation_case
        WHERE rule_code = #{ruleCode} AND business_key = #{businessKey} AND difference_type = #{differenceType} AND status IN ('OPEN', 'INVESTIGATING')
    </select>

    <!-- 冲突由受影响行数报告；身份、业务关联、规则快照及创建时间不允许被覆盖。 -->
    <update id="updateWithVersion">
        UPDATE reconciliation_case
        SET status = #{status},
            assignee = #{assignee},
            resolution = #{resolution},
            closed_at = #{closedAt},
            updated_at = #{updatedAt},
            version = version + 1
        WHERE id = #{id} AND version = #{version}
    </update>
</mapper>
