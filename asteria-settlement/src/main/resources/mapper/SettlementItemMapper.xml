<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.asteria.settlement.infrastructure.persistence.mapper.SettlementItemMapper">

    <resultMap id="BaseResultMap" type="io.asteria.settlement.infrastructure.persistence.dataobject.SettlementItemDO">
            <id property="id" column="id" />
            <result property="settlementBatchId" column="settlement_batch_id" />
            <result property="paymentId" column="payment_id" />
            <result property="paymentReference" column="payment_reference" />
            <result property="amount" column="amount" />
            <result property="currency" column="currency" />
            <result property="createdAt" column="created_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,settlement_batch_id,payment_id,payment_reference,amount,currency,
        created_at
    </sql>

    <insert id="batchInsert">
        INSERT INTO settlement_item (
        id,
        settlement_batch_id,
        payment_id,
        payment_reference,
        amount,
        currency,
        created_at
        )
        VALUES
        <foreach collection="items" item="item" separator=",">
            (
            #{item.id},
            #{item.settlementBatchId},
            #{item.paymentId},
            #{item.paymentReference},
            #{item.amount},
            #{item.currency},
            #{item.createdAt}
            )
        </foreach>
    </insert>
</mapper>
